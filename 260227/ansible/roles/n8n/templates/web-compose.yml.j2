services:
    n8n:
        image: n8nio/n8n:latest
        container_name: n8n-web
        restart: unless-stopped
        ports:
        - "5678:5678"
        environment:
            DB_TYPE: postgresdb
            DB_POSTGRESDB_HOST: 10.77.133.6
            DB_POSTGRESDB_DATABASE: n8n_db
            DB_POSTGRESDB_USER: n8n
            DB_POSTGRESDB_PASSWORD: "{{ vault_n8n_password }}"
            EXECUTIONS_MODE: queue
            QUEUE_BULL_REDIS_HOST: 10.77.133.5
            N8N_ENCRYPTION_KEY: "{{ vault_n8n_encryption_key }}"